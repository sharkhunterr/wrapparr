# Database
DATABASE_URL=postgresql+asyncpg://wrapparr:secret@postgres:5432/wrapparr

# Redis
REDIS_URL=redis://redis:6379/0

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
ENCRYPTION_KEY=change-me-in-production

# TMDB (optional — for movie/series posters)
TMDB_API_KEY=

# First admin account (created on first startup)
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-in-production
