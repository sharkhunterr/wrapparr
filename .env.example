# Wrapparr Configuration
# All fields are optional — sensible defaults are used

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=8173
PROD_PORT=8080

# Database (default: local SQLite in /app/data/)
# DATABASE_URL=sqlite+aiosqlite:///data/wrapparr.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://wrapparr:secret@postgres:5432/wrapparr

# Redis (optional — leave empty to disable)
# REDIS_URL=redis://redis:6379/0

# Security (auto-generated and persisted in data/.keys if not set)
# SECRET_KEY=
# ENCRYPTION_KEY=

# TMDB (optional — enables film enrichment: posters, ratings, budgets, etc.)
# TMDB_API_KEY=your-tmdb-api-key

# First admin account
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=changeme
