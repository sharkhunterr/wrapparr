# Wrapparr Configuration

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=8173
PROD_PORT=8080

# Database
DATABASE_URL=postgresql+asyncpg://wrapparr:secret@postgres:5432/wrapparr
DB_PASSWORD=secret

# Redis
REDIS_URL=redis://redis:6379/0

# Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=change-me-to-a-random-string
ENCRYPTION_KEY=change-me-to-another-random-string

# TMDB (optional — enables film enrichment)
TMDB_API_KEY=

# First admin account
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=changeme
